# Plan: 本地敏感配置模板（拷贝为 application-local.yaml 后填真值，不进 git）
#
# 启动方式：
#   IDEA Run Configuration → VM Options 加 -Dspring.profiles.active=local
#   或 env: SPRING_PROFILES_ACTIVE=local
#
# .gitignore 已排除 src/main/resources/application-local.yaml + *.pem + secrets/

ai:
  agent:
    qweather:
      enabled: true
      # 用户私有 API Host（注意：2026 起公开域名 api.qweather.com 停用，所有请求都用私有 host）
      api-host: <your-host>.qweatherapi.com
      # API KEY 鉴权（QWeather 控制台 → 凭据 → API KEY 类型，非 JWT）
      api-key: <your-32-char-api-key>

spring:
  ai:
    mcp:
      client:
        enabled: true
        sse:
          connections:
            tavily:
              # 把 tvly-xxx 真实 key 拼到 URL；或用环境变量 TAVILY_API_KEY 注入
              url: https://mcp.tavily.com/mcp/?tavilyApiKey=<your-tvly-key>
